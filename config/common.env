# Shared by both nodes. Rank-specific values live in head.env / worker.env.

# Prebuilt GB10 (SM121) vLLM 0.25 image with DSpark + nvfp4_ds_mla + b12x MoE.
# Pinned by digest so both nodes run byte-identical code.
VLLM_IMAGE=ghcr.io/anemll/dspark-vllm-gx10:0.1.1@sha256:a83948492cf13df455170fb42885f5ef4db54fefe0feff0f841ecbff464ac9d8

# Official checkpoint deepseek-ai/DeepSeek-V4-Flash-0731 (FP8 + FP4 MoE, ~167 GB).
# Must exist at this path on BOTH nodes (scripts/download-model.sh does that).
MODEL_DIR=/home/joshhu/models/DeepSeek-V4-Flash-0731
HF_CACHE=/home/joshhu/.cache/huggingface
JIT_TMP=/home/joshhu/.cache/dsv4-tmp
SERVED_MODEL_NAME=deepseek-v4-flash

# Rendezvous over the CX7 fabric (head's fabric IP), not the LAN / Wi-Fi.
MASTER_ADDR=10.20.0.11
MASTER_PORT=25000

# ConnectX-7: enp1s0f0np0 <-> rocep1s0f0, RoCE v2 IPv4 GID verified on both nodes.
# To try both PCIe halves of the CX7 port: NCCL_IB_HCA==rocep1s0f0,roceP2p1s0f0
NCCL_IB_HCA==rocep1s0f0
FABRIC_IF=enp1s0f0np0
# Set to INFO once to confirm "NET/IB" (RoCE) rather than "NET/Socket" in logs.
NCCL_DEBUG=WARN

# Serving profile (anemll validated: 350K ctx, 12 seqs, 0.78 util, MTP-5).
MAX_MODEL_LEN=350000
MAX_NUM_SEQS=12
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.78
MTP_NUM_TOKENS=5
# Default thinking mode (true/false); clients can override per request via chat_template_kwargs.
DEFAULT_THINKING=false

API_PORT=8888
